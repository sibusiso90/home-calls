# Copy to backend/.env for local dev. Every value is optional.

# Meta Model API. Leave empty to run with the deterministic offline mock models.
MODEL_API_KEY=
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# SPARK_MODEL=muse-spark-1.3
# TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# SAM_MODEL=sam-3.1
# MODEL_TIMEOUT_S=45
# MODEL_DEADLINE_S=60
# MODEL_MAX_RETRIES=3
# FFMPEG_PATH=ffmpeg

# Mock-only: force cut_match "uncertain" so proof of job lands in needs_review.
MOCK_FORCE_REVIEW=false
# Mock-only: add artificial latency to each model call (ms).
MOCK_LATENCY_MS=0

# Database: SQLite locally; Supabase Postgres in prod (postgres:// URLs are fine).
DATABASE_URL=sqlite:///./fadecall.db
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Signs tokens and media URLs. Use a long random value outside local dev.
SECRET_KEY=dev-only-change-me
OPERATOR_PASSCODE=fadecall-ops

# Days after a final verdict before raw proof photos are deleted.
EVIDENCE_RETENTION_DAYS=7

# Absolute base for signed media URLs (else taken from the request host).
# PUBLIC_BASE_URL=https://<you>--fade-call-api.modal.run
# CORS_ORIGINS=["*"]

# Storage: local (backend/.data/media) or supabase (private bucket).
STORAGE_BACKEND=local
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=fadecall-private

# Booking: a client cancelling closer than this to the slot forfeits a paid deposit.
LATE_CANCEL_HOURS=2

# WhatsApp copies of notifications (stretch goal). Off unless BOTH are set.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_API_VERSION=v21.0
